{
  "name": "sir-system-monitor",
  "version": "1.2.2",
  "description": "Electron app for monitoring system statistics",
  "author": "SiR_KaMiKaZeE",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaMiKaZeE1221/SiR-System-Monitor"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "node scripts/patch-nsis-details.js && electron-builder --win nsis portable",
    "minify": "node scripts/minify-all.js"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "electron": "40.7.0",
    "electron-builder": "^24.13.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.46.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "koffi": "^2.15.1",
    "systeminformation": "^5.21.0"
  },
  "build": {
    "appId": "com.sir.systemmonitor",
    "productName": "SiR System Monitor",
    "files": [
      "**/*",
      "!dist/**",
      "!dist*/**",
      "!build/**",
      "!recovered_source_from_setup_1_0_6/**",
      "!restored_from_setup_1_0_6/**",
      "!docs/**",
      "!.git/**",
      "!.vscode/**",
      "!GITHUB_UPLOAD_GUIDE.md",
      "!$null",
      "!_sensor_dump*.txt",
      "!*.log",
      "!README.md",
      "!test-*.js",
      "!SiR-System-Monitor-Setup-*.exe",
      "!SiR-System-Monitor-Portable-*.exe",
      "!*.blockmap",
      "!latest.yml",
      "!fresh_extract_v118/**",
      "!Restored From V118/**",
      "!restore_from_here/**",
      "!BuiltFromRestoredFilesV118/**",
      "! dist_extract/**",
      "!V1.1.8a/**",
      "!V1.1.9/**",
      "!V1.2.0/**",
      "!V1.2.1/**",
      "!V1.2.1a/**",
      "!scripts/build-installer.js",
      "!scripts/run-electron-builder.js"
    ],
    "directories": {
      "output": "V1.2.2"
    },
    "icon": "SiR_SM_Circle.ico",
    "win": {
      "icon": "SiR_SM_Circle.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "SiR-System-Monitor-Portable-1.2.2.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KaMiKaZeE1221",
        "repo": "SiR-System-Monitor"
      }
    ],
    "nsis": {
      "artifactName": "SiR-System-Monitor-Setup-1.2.2.${ext}",
      "license": "build/LICENSE.txt",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SiR System Monitor"
    }
  }
}
